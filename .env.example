# Real sources (Gmail, staff uploads, message imports, databases, Phone Link) are OFF unless this is true.
# Leave it unset on the hosted demo: it then only holds Tier 0 data (invented records, public documents)
# and offers demo accounts. start.bat sets it to true for your own PC. The web interface cannot change it.
REAL_SOURCES=false
# Record text goes to an outside embedding service only after an approved model and hosting are named.
EMBEDDINGS_RECORD_CONTENT_APPROVED=false

# Copy to .env (never commit .env). Every value is optional unless marked REQUIRED for that feature.
# The server reads real environment variables first; .env only fills in what is missing.

# --- Server ---------------------------------------------------------------
PORT=8765
# The address people use to reach the app. Must be https:// in production (enables Secure cookies).
PUBLIC_URL=http://localhost:8765
# NODE_ENV=production            # in production a missing CREDENTIAL_ENCRYPTION_KEY disables connectors instead of generating a dev key
# DATA_DIR=./data                 # database, uploaded originals, development key file
# TRUST_PROXY=false               # true only behind a reverse proxy that sets X-Forwarded-For
# DEMO_ONLY=false                 # true = synthetic demo only; every real-data endpoint is switched off
# SETUP_TOKEN=                    # lets you create the first administrator from a non-local browser
# SESSION_TTL_HOURS=12
# IP_HASH_SALT=                   # salt for the one-way IP hashes stored in the audit log

# --- Credential encryption (REQUIRED in production for Gmail and database passwords) ---
# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# Keep it outside the database, e.g. in your host's secret manager. Losing it means reconnecting every source.
CREDENTIAL_ENCRYPTION_KEY=

# --- Claude (search plans and evidence summaries) -------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MAX_TOKENS=2048
# ANTHROPIC_TIMEOUT_MS=60000
# ANTHROPIC_MAX_RETRIES=3
# AI_SUMMARY_TOP_K=8              # how many top results Claude may read for a summary
# USD per million tokens, for the cost estimate on the Settings page. Copy current prices from the Anthropic pricing page.
# ANTHROPIC_PRICE_INPUT_PER_MTOK=
# ANTHROPIC_PRICE_OUTPUT_PER_MTOK=

# --- Semantic search (optional; keyword search works without it) ----------
# none | voyage | openai-compatible
EMBEDDINGS_PROVIDER=none
# EMBEDDINGS_MODEL=               # e.g. a Voyage model name from docs.voyageai.com
# EMBEDDINGS_API_KEY=
# EMBEDDINGS_BASE_URL=            # openai-compatible only, e.g. http://localhost:11434/v1 for a local model server

# --- Gmail (Google OAuth 2.0) ---------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to PUBLIC_URL + /oauth/google/callback. Register exactly this URI in Google Cloud.
# GOOGLE_REDIRECT_URI=
# GMAIL_DEFAULT_QUERY=newer_than:2y
# GMAIL_MAX_MESSAGES_PER_SYNC=500
# GMAIL_INDEX_ATTACHMENTS=true
# GMAIL_MAX_ATTACHMENT_BYTES=10485760

# --- Uploads and OCR ------------------------------------------------------
# UPLOAD_MAX_BYTES=26214400
# OCR_ENABLED=true
# OCR_LANG=eng
# OCR_LANG_PATH=                  # folder with eng.traineddata for offline OCR; otherwise downloaded on first use

# --- Database connectors --------------------------------------------------
# DB_CONNECTOR_TIMEOUT_MS=15000
# DB_CONNECTOR_MAX_ROWS=5000
# SQLite connector files must live in DATA_DIR/connectors

# --- Retention (days) -----------------------------------------------------
# RETENTION_SEARCH_HISTORY_DAYS=365
# RETENTION_AUDIT_DAYS=730
# RETENTION_AI_USAGE_DAYS=365

# --- Rate limits ----------------------------------------------------------
# RATE_LIMIT_LOGIN=10             # attempts per 15 minutes per IP and email
# RATE_LIMIT_API_PER_MINUTE=240
# RATE_LIMIT_SEARCH_PER_MINUTE=30

# Android texts through Windows Phone Link (no export needed). Works when this app runs on the same
# Windows PC and Windows user as Phone Link; the file is found automatically.
# PHONELINK_DB_PATH=            # optional: full path to Phone Link's phone.db if it lives elsewhere
PHONELINK_SYNC_MINUTES=5        # how often to check Phone Link for new texts (0 = only before searches and on Sync now)
