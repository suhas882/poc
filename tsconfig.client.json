{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "outDir": ".",
    "rootDir": ".",
    "noEmitOnError": true
  },
  "include": [
    "client/**/*.ts"
  ],
  "exclude": []
}