# Production settings for the server. Copy to .env.production ON THE SERVER, fill in, and keep it there:
# never commit it, email it or paste it into chat. Every value below is read by the app from the environment.
#
#   docker compose --env-file .env.production up -d --build

# --- Where people reach the app ---------------------------------------------
# Host name only (Caddy gets the HTTPS certificate for it). On Azure, a free name is
# <label>.<region>.cloudapp.azure.com (VM > Networking > Public IP > DNS name label).
DOMAIN=records-poc.eastus.cloudapp.azure.com
PUBLIC_URL=https://records-poc.eastus.cloudapp.azure.com

# --- Real sources -----------------------------------------------------------
REAL_SOURCES=true

# --- Secrets the server generates once (see docs/DEPLOY.md) -------------------
# 32 random bytes, base64. MOVING EXISTING DATA? Use the SAME key the old server used (the content of its
# data/.credential-key file), or every stored Google/Microsoft connection has to be reconnected.
CREDENTIAL_ENCRYPTION_KEY=
IP_HASH_SALT=
# Only for creating the first Supervisor on an empty server from a browser that is not on the server itself.
SETUP_TOKEN=

# --- Google (one OAuth client for everyone; users only sign in and consent) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (one Entra app registration for everyone) ----------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" for personal + work accounts; or the directory (tenant) ID for one organization only.
MICROSOFT_TENANT=common

# --- Optional ---------------------------------------------------------------
# ANTHROPIC_API_KEY=            # plan drafting only; record text is never sent to a model
# CLAMAV_HOST=                  # virus scanning of uploads (see docs/SETUP.md)
# CLAMAV_REQUIRED=false
# UPLOAD_MAX_BYTES=26214400
